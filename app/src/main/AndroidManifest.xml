<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Hide clock: writes the SystemUI icon_blacklist secure setting. The
         system never grants this to a third-party app at install; the user
         grants it once over adb:
         adb shell pm grant com.supernova.launcher android.permission.WRITE_SECURE_SETTINGS
         Without the grant the Hide clock preference is inert. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Runtime-gated; requested from the Search settings section and only
         used by the contacts search provider (and the feed's starred
         contacts card). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- The popup menu's optional Close app / Relaunch rows. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The drawer popup's Uninstall row and the Uninstall drop target fire
         ACTION_DELETE. From targetSdk 28 the system uninstaller finishes
         silently unless the caller holds this (install-time) permission. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only for Settings > Icons & labels > Test notification badge, which
         posts one notification from Supernova itself; asked for from that
         row. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Feed page (Phase 7). All runtime-gated and requested contextually
         (feed settings rows, in-card grant buttons, the card editor) - never
         at startup. READ_CALENDAR backs the upcoming-events card;
         ACCESS_FINE_LOCATION is only for reading the Wi-Fi SSID behind
         card visibility conditions; BLUETOOTH_CONNECT (31+) / legacy
         BLUETOOTH (<= 30) back the Bluetooth device-name condition. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Night mode's Auto, with Location enhancement on: the last known
         fix's city, for sunset and sunrise times. Asked for from that
         settings row only. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- registerNetworkCallback needs this; without it the Wi-Fi card
         condition's callback registration threw and was swallowed. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Suggested shortcuts skip home apps (AppCatalog.homePackages);
             a launcher with no drawer entry is otherwise invisible to the
             HOME query on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The starting dock resolves the device's default dialer, camera,
             and browser (DefaultLayoutBuilder); without these, resolveActivity
             returns nothing on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- The legacy shortcut picker lists apps offering CREATE_SHORTCUT
             activities; without this they are invisible on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.CREATE_SHORTCUT" />
        </intent>
        <!-- Icon packs advertise themselves with one of these theme actions;
             without these entries they stay invisible on Android 11+. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
    </queries>

    <application
        android:name=".SupernovaApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Supernova">

        <!-- Its own task: a distinct
             taskAffinity plus singleTask puts Settings in a separate recents
             card instead of stacking on the home task (which recents never
             shows), and reopening it resumes that card rather than starting
             over. The label titles the card. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_launcher_label"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.settings" />

        <!-- Puts a "Supernova Settings" entry in every launcher's drawer;
             hideable via Hide apps. The target
             activity stays non-exported - the alias carries its own export. -->
        <activity-alias
            android:name=".SettingsLauncherAlias"
            android:targetActivity=".SettingsActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_settings"
            android:label="@string/settings_launcher_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- First-run wizard. Mirrors SettingsActivity's declaration, plus:
             excluded from recents (it's a transient overlay on the launcher),
             singleTop so a re-launch while visible doesn't stack copies. The
             gate in LauncherActivity re-opens it on the next launch until
             finished or skipped, so leaving via Home isn't a trap. -->
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Backs the "Share backup" chooser; exposes only cacheDir/share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".notification.SupernovaNotificationListener"
            android:exported="true"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".SupernovaAccessibilityService"
            android:exported="true"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- configChanges: rotation and window resizes are handled in place
             by onConfigurationChanged. A launcher that is torn down and
             rebuilt on every rotation re-queries the app list, re-creates
             every widget host view (each one blank until its provider
             redelivers) and drops the open drawer/folder/edit mode - so the
             activity keeps itself and re-lays the chrome out instead.
             uiMode, density, fontScale and locale are deliberately NOT here:
             those change resolved resources, and a real re-create is right. -->
        <activity
            android:name=".LauncherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Device admin (force-lock only) backing the device-admin screen
             lock method, as an alternative to the accessibility service. -->
        <receiver
            android:name=".SupernovaDeviceAdmin"
            android:description="@string/lock_admin_explanation"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- The "Apply" button inside an icon pack's own app. Pack dashboards
             fire a per-launcher action carrying the pack's package; the
             activity accepts the conventions the common templates already
             send, and confirms with the user before changing anything. -->
        <activity
            android:name=".ApplyIconPackActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_label"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.applyiconpack"
            android:theme="@style/Theme.Supernova.Transparent">
            <intent-filter>
                <action android:name="com.supernova.launcher.APPLY_ICON_THEME" />
                <action android:name="com.anddoes.launcher.SET_THEME" />
                <action android:name="org.adw.launcher.SET_THEME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Lets other apps ask to pin a shortcut or widget to the home screen;
             the system only delivers these to the default launcher. -->
        <activity
            android:name=".PinRequestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Supernova.Transparent">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.appwidget.action.APPWIDGET_CONFIRM_PIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
