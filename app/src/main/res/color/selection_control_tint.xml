<?xml version="1.0" encoding="utf-8"?>
<!-- Checkboxes and radio buttons: the accent when checked, the quiet
     secondary text color when not, so the checked one is what stands out. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/textSecondary" android:alpha="0.38" android:state_enabled="false" />
    <item android:color="?attr/colorAccent" android:state_checked="true" />
    <item android:color="@color/textSecondary" />
</selector>
