<?xml version="1.0" encoding="utf-8"?>
<!-- First run. The steps: a top bar (back, progress, Skip), the live
     preview of the home screen over the real wallpaper (the pane clears its
     rectangle to show it), the step's question and choices, and Next. The
     welcome page lies over all of it until Design my homescreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboardingBackground"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/onboardingFlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/onboardingBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_previous"
                android:src="@drawable/ic_back"
                app:tint="@android:color/white" />

            <LinearLayout
                android:id="@+id/onboardingProgress"
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/onboardingSkip"
                style="@style/OnboardingTextButton"
                android:layout_gravity="end|center_vertical"
                android:text="@string/onboarding_skip" />
        </FrameLayout>

        <com.supernova.launcher.ui.settings.preview.PreviewPane
            android:id="@+id/onboardingPreviewPane"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:importantForAccessibility="noHideDescendants">

            <com.supernova.launcher.onboarding.HomePreviewView
                android:id="@+id/onboardingPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </com.supernova.launcher.ui.settings.preview.PreviewPane>

        <LinearLayout
            android:id="@+id/onboardingPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/onboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/onboardingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/onboardingSummary"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/onboardingOptions"
                android:layout_width="match_parent"
                android:layout_height="196dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/onboardingNext"
            style="@style/OnboardingPrimaryButton"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/next" />
    </LinearLayout>

    <include
        android:id="@+id/onboardingWelcome"
        layout="@layout/onboarding_page_welcome" />
</FrameLayout>
