<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_sm"
    android:background="@drawable/bg_feed_card"
    android:orientation="vertical"
    android:padding="@dimen/space_ms">

    <TextView
        android:id="@+id/calendarHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/feed_calendar_title"
        android:textSize="@dimen/text_secondary"
        android:textStyle="bold" />

    <!-- Event rows are added programmatically (<= 5). -->
    <LinearLayout
        android:id="@+id/calendarEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/calendarPermissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/feed_calendar_permission"
        android:textSize="@dimen/text_secondary"
        android:visibility="gone" />

    <Button
        android:id="@+id/calendarGrantButton"
        style="@style/Widget.Supernova.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feed_grant_access"
        android:visibility="gone" />
</LinearLayout>
