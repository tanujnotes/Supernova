<?xml version="1.0" encoding="utf-8"?>
<!-- A group's label on a settings page: over its card, in
     line with the card's content (the decoration's 16dp gutter plus this
     16dp), 8dp clear of it. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fontFamily="sans-serif-medium"
    android:letterSpacing="0.015"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingBottom="@dimen/space_sm"
    android:textColor="@color/textSecondary"
    android:textSize="@dimen/text_secondary" />
