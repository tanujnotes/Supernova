<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp">

        <!-- Live preview reflecting every edit before OK commits. -->
        <com.supernova.launcher.ui.SearchBarView
            android:id="@+id/searchBarPreview"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="16dp" />

        <RadioGroup
            android:id="@+id/placementGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/placementNone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_bar_none"
                android:textColor="@color/textPrimary" />

            <RadioButton
                android:id="@+id/placementAbove"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_bar_above_dock"
                android:textColor="@color/textPrimary" />

            <RadioButton
                android:id="@+id/placementBelow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_bar_below_dock"
                android:textColor="@color/textPrimary" />

            <RadioButton
                android:id="@+id/placementPersistent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_bar_persistent"
                android:textColor="@color/textPrimary" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_corner_radius"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/radiusDown"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stepper_decrease"
                android:src="@drawable/ic_step_minus"
                app:tint="@color/textPrimary" />

            <TextView
                android:id="@+id/radiusValue"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/radiusUp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/stepper_increase"
                android:src="@drawable/ic_step_plus"
                app:tint="@color/textPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/style_opacity"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/alphaSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100" />

            <TextView
                android:id="@+id/alphaValue"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/wireframeCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_wireframe"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/shadowCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_shadow"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/hintCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_hint_text"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/search_bar_logo"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/logoGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/logoSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_bar_logo_search"
                android:textColor="@color/textPrimary" />

            <RadioButton
                android:id="@+id/logoSupernova"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/search_bar_logo_supernova"
                android:textColor="@color/textPrimary" />

            <RadioButton
                android:id="@+id/logoNone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/search_bar_logo_none"
                android:textColor="@color/textPrimary" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/logoMonochrome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_logo_monochrome"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/search_bar_chips"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/chipVoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_chip_voice"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/chipAssistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_chip_assistant"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/chipDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_bar_chip_date"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/chipPlayStoreBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/chip_play_store"
            android:textColor="@color/textPrimary" />

        <CheckBox
            android:id="@+id/chipDrawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_open_drawer"
            android:textColor="@color/textPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/search_bar_chips_order"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
