<?xml version="1.0" encoding="utf-8"?>
<!-- The Activities picker: every installed app as a collapsible card, each
     opening into the activities it lets other apps start, under the widget
     sheet's search field. The list frame's height is set from the window's
     in ActivitiesPickerSheet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/sheet_handle" />

    <TextView
        style="@style/SheetTitle"
        android:paddingBottom="@dimen/space_ms"
        android:text="@string/add_category_activities" />

    <!-- The widget sheet's search field. No saved state, as with drawerSearch. -->
    <EditText
        android:id="@+id/activitiesSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_ms"
        android:background="@drawable/bg_search_card"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="12dp"
        android:hint="@string/search_activities_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_ml"
        android:paddingVertical="@dimen/space_md"
        android:saveEnabled="false"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/text_body" />

    <FrameLayout
        android:id="@+id/activitiesFrame"
        android:layout_width="match_parent"
        android:layout_height="560dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/activitiesRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_lg" />

        <ProgressBar
            android:id="@+id/activitiesProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/activitiesEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_activities"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- The drawer's fast scrollbar and its letter bubble. -->
        <com.supernova.launcher.ui.FastScrollerView
            android:id="@+id/activitiesFastScroller"
            android:layout_width="32dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone" />

        <TextView
            android:id="@+id/activitiesFastScrollBubble"
            android:layout_width="75dp"
            android:layout_height="62dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="@dimen/space_ml"
            android:background="@drawable/bg_fast_scroll_bubble"
            android:elevation="3dp"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:paddingHorizontal="@dimen/space_ms"
            android:textSize="@dimen/text_display"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
