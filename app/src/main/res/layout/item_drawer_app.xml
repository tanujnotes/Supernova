<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren and clipToPadding off: an icon's shadow falls outside its
     image view, into this layout's padding (data/ShadowedIconDrawable). With
     clipToPadding on, the padding still cut it: in the dock, labels hidden,
     the shadow stopped dead at the icon's top and bottom edges. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_icon"
    android:gravity="center_horizontal"
    android:minHeight="98dp"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="12dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_supernova" />

    <TextView
        android:id="@+id/appLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/textPrimary"
        android:textSize="13sp" />
</LinearLayout>
