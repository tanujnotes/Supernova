<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folderScrim"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/folderCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_folder"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/space_ms">

        <com.supernova.launcher.ui.FolderGridView
            android:id="@+id/folderGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <!-- The title sits under the grid, at the foot of the card. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/folderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/folder_name"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:maxLength="@integer/label_max_length"
                android:maxLines="1"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingTop="@dimen/space_sm"
                android:textColor="@color/textPrimary"
                android:textColorHint="@color/textSecondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <!-- The number of apps, when the setting asks for it. -->
            <TextView
                android:id="@+id/folderCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_xs"
                android:paddingTop="@dimen/space_sm"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_secondary"
                android:visibility="gone" />

            <!-- A text button the caller asks for (the private space
                 card's Lock). Its top padding matches the title's, so the
                 two sit on one line. -->
            <TextView
                android:id="@+id/folderAction"
                style="@style/DrawerPrivateButton"
                android:paddingTop="@dimen/space_sm"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/folderEditButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/folder_menu"
                android:padding="@dimen/space_sm"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/textPrimary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
