<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app Edit sheet. The plate and its corners come from the theme's
     bottom-sheet style; rows read like settings rows - a title with the
     current value in a pill - so a row is a thing to change rather than a
     sentence to parse. The rows scroll between a pinned title and a pinned
     button row, so Save is in reach however many rows the item has. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_md">

    <include layout="@layout/sheet_handle" />

    <TextView
        android:id="@+id/editTitle"
        style="@style/SheetTitle" />

    <!-- Labs: the app's component name, selectable to copy. -->
    <TextView
        android:id="@+id/editComponent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_ml"
        android:paddingBottom="@dimen/space_sm"
        android:fontFamily="monospace"
        android:textColor="@color/textSecondary"
        android:textIsSelectable="true"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_ml"
                android:layout_marginTop="@dimen/space_ms"
                android:hint="@string/rename">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="@integer/label_max_length"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/hideLabelRow"
                style="@style/SheetRow"
                android:layout_marginTop="@dimen/space_sm">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/hide_label" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/hideLabelSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/hide_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shapeRow"
                style="@style/SheetRow">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/icon_shape" />

                <TextView
                    android:id="@+id/shapeValue"
                    style="@style/SheetRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/variantRow"
                style="@style/SheetRow">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/icon_variant" />

                <TextView
                    android:id="@+id/variantValue"
                    style="@style/SheetRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/iconRow"
                style="@style/SheetRow">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/icon_row" />

                <TextView
                    android:id="@+id/iconValue"
                    style="@style/SheetRowValue" />
            </LinearLayout>

            <!-- Folders only, while a custom icon is chosen: off draws it
                 as it is, unshaped. -->
            <LinearLayout
                android:id="@+id/reshapeRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_ml"
                android:paddingVertical="@dimen/space_ms"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reshape"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/reshape_summary"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/reshapeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms" />
            </LinearLayout>

            <!-- Folders only: Swipe to open folder, which takes the
                 swipe up below it over while on. -->
            <LinearLayout
                android:id="@+id/swipeToOpenRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_ml"
                android:paddingVertical="@dimen/space_ms"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/swipe_to_open_folder"
                        android:textColor="@color/textPrimary"
                        android:textSize="@dimen/text_body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/swipe_to_open_folder_summary"
                        android:textColor="@color/textSecondary"
                        android:textSize="@dimen/text_secondary" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swipeToOpenSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_ms" />
            </LinearLayout>

            <!-- Per-item swipe gestures. Shown only when editing a placed
                 workspace item (drawer edits are app-level and have no swipe
                 target). -->
            <LinearLayout
                android:id="@+id/swipeUpRow"
                style="@style/SheetRow"
                android:visibility="gone">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/swipe_up_title" />

                <TextView
                    android:id="@+id/swipeUpValue"
                    style="@style/SheetRowValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/swipeDownRow"
                style="@style/SheetRow"
                android:visibility="gone">

                <TextView
                    style="@style/SheetRowTitle"
                    android:text="@string/swipe_down_title" />

                <TextView
                    android:id="@+id/swipeDownValue"
                    style="@style/SheetRowValue" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_ml">

        <Button
            android:id="@+id/resetButton"
            style="@style/Widget.Supernova.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reset" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
