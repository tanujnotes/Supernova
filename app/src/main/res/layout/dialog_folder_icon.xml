<?xml version="1.0" encoding="utf-8"?>
<!-- Folder icon appearance: a live preview of the folder icon on its own
     card, then the background shape (a choice) and three options, in rows
     that reach the dialog's sides with their controls in a 48dp column 8dp
     in from its edge. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_ms"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_settings_preview">

        <ImageView
            android:id="@+id/folderIconPreview"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/shapeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/folder_icon_shape"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/shapeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:ellipsize="end"
            android:maxWidth="140dp"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_sm"
            android:importantForAccessibility="no"
            android:paddingHorizontal="@dimen/space_md"
            android:src="@drawable/ic_settings_chevron"
            app:tint="@color/textSecondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_lg"
        android:background="@color/settingsDivider" />

    <LinearLayout
        android:id="@+id/outlineRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/folder_icon_outline"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/outlineCheck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_md"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="48dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_lg"
        android:background="@color/settingsDivider" />

    <LinearLayout
        android:id="@+id/clipRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/folder_clip_to_bg"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/clipCheck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_md"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="48dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_lg"
        android:background="@color/settingsDivider" />

    <LinearLayout
        android:id="@+id/matchColorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/folder_match_window_color"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/matchColorCheck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_md"
            android:clickable="false"
            android:focusable="false"
            android:minWidth="48dp" />
    </LinearLayout>

    <!-- Shown while the plate doesn't match the window. -->
    <View
        android:id="@+id/colorDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/space_lg"
        android:background="@color/settingsDivider" />

    <LinearLayout
        android:id="@+id/colorRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/folder_plate_color"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/colorValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:ellipsize="end"
            android:maxWidth="140dp"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />

        <ImageView
            android:layout_width="48dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/space_sm"
            android:importantForAccessibility="no"
            android:paddingHorizontal="@dimen/space_md"
            android:src="@drawable/ic_settings_chevron"
            app:tint="@color/textSecondary" />
    </LinearLayout>

</LinearLayout>
