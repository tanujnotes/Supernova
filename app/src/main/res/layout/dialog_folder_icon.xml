<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/folderIconPreview"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/shapeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/folder_icon_shape"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/shapeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/outlineCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder_icon_outline"
        android:textColor="@color/textPrimary" />

    <CheckBox
        android:id="@+id/clipCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder_clip_to_bg"
        android:textColor="@color/textPrimary" />

    <CheckBox
        android:id="@+id/matchColorCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/folder_match_window_color"
        android:textColor="@color/textPrimary" />
</LinearLayout>
