<?xml version="1.0" encoding="utf-8"?>
<!-- Add drawer tab / Add drawer folder: the title field (filled in
     code through DialogField.wrap) and Keep apps in main app tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/newGroupField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/newGroupKeep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="24dp"
        android:text="@string/group_keep_in_main" />
</LinearLayout>
