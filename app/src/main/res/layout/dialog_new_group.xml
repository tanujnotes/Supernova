<?xml version="1.0" encoding="utf-8"?>
<!-- Add drawer tab / Add drawer folder: the title field (filled in
     code through DialogField.wrap) and Keep apps in main app tab. Edit tab
     also shows the tab's icon row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/newGroupField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <CheckBox
        android:id="@+id/newGroupKeep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_ml"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/space_lg"
        android:paddingStart="@dimen/space_ms"
        android:paddingEnd="0dp"
        android:text="@string/group_keep_in_main" />

    <LinearLayout
        android:id="@+id/newGroupIconRow"
        style="@style/SheetRow"
        android:layout_marginTop="@dimen/space_xs"
        android:paddingHorizontal="@dimen/space_lg"
        android:visibility="gone">

        <TextView
            style="@style/SheetRowTitle"
            android:text="@string/icon_row" />

        <TextView
            android:id="@+id/newGroupIconValue"
            style="@style/SheetRowValue" />
    </LinearLayout>
</LinearLayout>
