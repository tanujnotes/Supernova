<?xml version="1.0" encoding="utf-8"?>
<!-- Two widget previews side by side (a two-column grid). Each cell:
     preview, widget name, span, app name. cellB hides when the row is odd. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_ms"
    android:layout_marginBottom="@dimen/space_xs"
    android:background="@drawable/bg_picker_card"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="@dimen/space_ms">

    <LinearLayout
        android:id="@+id/cellA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <ImageView
            android:id="@+id/previewA"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="@string/widget"
            android:scaleType="fitCenter" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/labelA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_ms"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/spanA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/providerA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cellB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/space_sm">

        <ImageView
            android:id="@+id/previewB"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:contentDescription="@string/widget"
            android:scaleType="fitCenter" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/labelB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_ms"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/spanB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/providerB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />
    </LinearLayout>
</LinearLayout>
