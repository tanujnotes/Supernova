<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_sm">

    <include layout="@layout/sheet_handle" />

    <TextView
        android:id="@+id/pickerTitle"
        style="@style/SheetTitle"
        android:text="@string/pick_icon" />

    <EditText
        android:id="@+id/iconSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_md"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_search_card"
        android:hint="@string/search_icons_hint"
        android:importantForAutofill="no"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/space_ml"
        android:paddingVertical="@dimen/space_md"
        android:textColor="@color/textPrimary"
        android:textColorHint="@color/textSecondary"
        android:textSize="@dimen/text_body" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/iconGrid"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_marginTop="@dimen/space_sm"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_ms" />
</LinearLayout>
