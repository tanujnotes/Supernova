<?xml version="1.0" encoding="utf-8"?>
<!-- One action in the card editor: icon, label, remove, and a
     drag handle for reordering. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/actionIcon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/actionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/textPrimary"
        android:textSize="16sp" />

    <ImageButton
        android:id="@+id/actionRemove"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove"
        android:src="@drawable/ic_menu_remove"
        app:tint="@color/textPrimary" />

    <ImageView
        android:id="@+id/actionHandle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/card_reorder"
        android:padding="10dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/textSecondary" />
</LinearLayout>
