<?xml version="1.0" encoding="utf-8"?>
<!-- A Cards page entry: the card's name with a gear, over a live
     rendering of the card itself. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/cardGear"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/card_settings"
            android:src="@drawable/ic_tab_settings"
            app:tint="@color/textPrimary" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/cardPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
