<?xml version="1.0" encoding="utf-8"?>
<!-- Top hit: the best app match as a card - big icon, name, an app
     info gear - and, under a hairline, the app's shortcuts as pills. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_md"
    android:layout_marginVertical="@dimen/space_sm"
    android:background="@drawable/bg_feed_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_ms"
    android:paddingBottom="@dimen/space_ms">

    <LinearLayout
        android:id="@+id/topHitRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/topHitIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="@dimen/space_ml"
            android:importantForAccessibility="no" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/topHitLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="@dimen/text_headline" />

        <ImageButton
            android:id="@+id/topHitInfo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_info"
            android:src="@drawable/ic_tab_settings" />
    </LinearLayout>

    <View
        android:id="@+id/topHitDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_ms"
        android:importantForAccessibility="no" />

    <com.supernova.launcher.ui.FlowLayout
        android:id="@+id/topHitShortcuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms" />
</LinearLayout>
