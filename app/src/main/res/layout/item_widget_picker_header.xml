<?xml version="1.0" encoding="utf-8"?>
<!-- A collapsible per-app card: icon, name, "N widgets, M shortcuts", chevron. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_ms"
    android:layout_marginVertical="@dimen/space_xs"
    android:background="@drawable/bg_picker_card"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_ml">

    <ImageView
        android:id="@+id/headerIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/app_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_ml"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/headerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/textPrimary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />
    </LinearLayout>

    <ImageView
        android:id="@+id/headerChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        app:tint="@color/textSecondary" />
</LinearLayout>
