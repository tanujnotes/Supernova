<?xml version="1.0" encoding="utf-8"?>
<!-- Custom color: a preview, a Color (hue) slider, a Shade slider, a hex
     field and the last few custom colors; Use color hands the color back.
     Opened from the + swatch of the style and color sheets. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_md">

        <include layout="@layout/sheet_handle" />

        <TextView
            style="@style/SheetTitle"
            android:text="@string/custom_color_title" />

        <TextView
            android:id="@+id/customSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_ml"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_ml">

            <FrameLayout
                android:id="@+id/customPreview"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginTop="@dimen/space_md">

                <TextView
                    android:id="@+id/customPreviewHex"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="@dimen/space_md"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="@dimen/text_body" />
            </FrameLayout>

            <TextView
                android:id="@+id/customHueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_ml"
                android:labelFor="@id/customHueSeek"
                android:text="@string/color_hue"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <View
                    android:id="@+id/customHueTrack"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no" />

                <SeekBar
                    android:id="@+id/customHueSeek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:max="359"
                    android:paddingHorizontal="14dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/customShadeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:labelFor="@id/customShadeSeek"
                android:text="@string/color_shade"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <View
                    android:id="@+id/customShadeTrack"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:importantForAccessibility="no" />

                <SeekBar
                    android:id="@+id/customShadeSeek"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingHorizontal="14dp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/customHexBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <TextView
                android:id="@+id/customRecentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/color_recent"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:id="@+id/customRecentRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/customCancel"
                    style="@style/Widget.Supernova.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@android:string/cancel" />

                <Button
                    android:id="@+id/customUse"
                    style="@style/Widget.Supernova.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/custom_color_use" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
