<?xml version="1.0" encoding="utf-8"?>
<!-- Generic search result row: app, shortcut, contact, web, recent query. -->
<!-- clipChildren and clipToPadding off: an icon's shadow falls outside its
     image view, into this layout's padding (data/ShadowedIconDrawable). With
     clipToPadding on, the padding still cut it: in the dock, labels hidden,
     the shadow stopped dead at the icon's top and bottom edges. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_icon"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_ml"
    android:paddingVertical="@dimen/space_sm"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/resultIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <com.supernova.launcher.ui.FadingTextView
        android:id="@+id/resultLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:maxLines="1"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/text_body" />
</LinearLayout>
