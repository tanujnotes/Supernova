<?xml version="1.0" encoding="utf-8"?>
<!-- Generic search result row: app, shortcut, contact, web, recent query. -->
<!-- clipChildren off: an icon's shadow falls outside its image view, into
     this layout's padding (data/ShadowedIconDrawable). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_icon"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="6dp"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/resultIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/resultLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/textPrimary"
        android:textSize="15sp" />
</LinearLayout>
