<?xml version="1.0" encoding="utf-8"?>
<!-- The feed pane: a full-height sibling overlay of the workspace, parked at
     translationX = -width while closed (FeedController owns the parking and
     the open/close translate animation). clickable so touches never leak
     through to the workspace; elevation below the drawer sheet (12dp) so an
     open drawer still wins. Its background is a wallpaper dim, set by the
     controller, and the desktop fades out under it as it comes in - the
     feed page shows dimmed wallpaper, never the home screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedPane"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:elevation="10dp"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Header: the search pill alone. Add card and Feed settings sit at
         the end of the list (item_feed_add); with the pill off there is no
         header at all. -->
    <LinearLayout
        android:id="@+id/feedHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_ms"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.supernova.launcher.ui.SearchBarView
            android:id="@+id/feedSearchBar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/feedRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/space_ms"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_lg" />
</LinearLayout>
