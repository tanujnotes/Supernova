<?xml version="1.0" encoding="utf-8"?>
<!-- The Drawer groups page with no groups yet: what a tab or a folder is,
     with a small picture of it, and the button that makes one. The pictures
     are tiles in sample colours, as the folder icon editor's preview uses. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- A tab bar with one tab picked out, over a row of apps. -->
    <LinearLayout
        android:id="@+id/emptyArtTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_preview"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="68dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_group_chip"
                android:backgroundTint="@color/group_chip_background" />

            <View
                android:id="@+id/emptyArtTab"
                android:layout_width="62dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_group_chip"
                android:backgroundTint="@color/group_chip_background" />

            <View
                android:layout_width="58dp"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_group_chip"
                android:backgroundTint="@color/group_chip_background" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_group_art_tile"
                android:backgroundTint="@color/accentBlue" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_group_art_tile"
                android:backgroundTint="@color/accentGreen" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_group_art_tile"
                android:backgroundTint="@color/accentOrange" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_group_art_tile"
                android:backgroundTint="@color/accentPurple" />

            <View
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_group_art_tile"
                android:backgroundTint="@color/accentPink" />
        </LinearLayout>
    </LinearLayout>

    <!-- A row of apps with one tile a folder of four. -->
    <LinearLayout
        android:id="@+id/emptyArtFolders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_settings_preview"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_group_art_tile"
            android:backgroundTint="@color/accentTeal" />

        <GridLayout
            android:id="@+id/emptyArtFolder"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_group_art_tile"
            android:backgroundTint="@color/group_chip_background"
            android:columnCount="2"
            android:padding="4dp">

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_margin="1dp"
                android:background="@color/accentPink" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_margin="1dp"
                android:background="@color/accentBlue" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_margin="1dp"
                android:background="@color/accentAmber" />

            <View
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_margin="1dp"
                android:background="@color/accentGreen" />
        </GridLayout>

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_group_art_tile"
            android:backgroundTint="@color/accentOrange" />

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_group_art_tile"
            android:backgroundTint="@color/accentIndigo" />

        <View
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_group_art_tile"
            android:backgroundTint="@color/accentPurple" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2sp"
        android:textColor="@color/textSecondary"
        android:textSize="14sp" />

    <Button
        android:id="@+id/emptyAdd"
        style="@style/Widget.Supernova.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/colorAccentOnRaised" />
</LinearLayout>
