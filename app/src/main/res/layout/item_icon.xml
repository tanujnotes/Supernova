<?xml version="1.0" encoding="utf-8"?>
<!-- clipChildren off: an icon's shadow falls outside its image view, into
     this layout's padding (data/ShadowedIconDrawable). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="@drawable/ripple_icon"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_supernova" />

    <TextView
        android:id="@+id/label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/onWallpaper"
        android:textSize="12sp" />
</LinearLayout>
