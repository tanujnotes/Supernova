<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_feed_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/contactsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/feed_contacts_title"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Circular photo/letter tiles are added programmatically (<= 8). -->
    <LinearLayout
        android:id="@+id/contactsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/contactsPermissionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/feed_contacts_permission"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/contactsGrantButton"
        style="@style/Widget.Supernova.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/feed_grant_access"
        android:visibility="gone" />
</LinearLayout>
