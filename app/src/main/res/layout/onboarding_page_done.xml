<?xml version="1.0" encoding="utf-8"?>
<!-- The last page: All done!, its sparks over "Setup is finished", and a
     full-width Go home. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="64dp">

    <TextView
        style="@style/OnboardingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:text="@string/onboarding_all_done" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkles"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_setup_finished"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/doneGoHome"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_onboarding_filled"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/onboarding_go_home"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:textStyle="bold" />
</FrameLayout>
