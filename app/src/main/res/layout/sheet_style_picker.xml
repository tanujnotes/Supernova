<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_ml">

        <include layout="@layout/sheet_handle" />

        <TextView
            android:id="@+id/styleTitle"
            style="@style/SheetTitle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_ml">

        <FrameLayout
            android:id="@+id/stripSurface"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/space_md"
            android:paddingHorizontal="@dimen/space_ml">

            <TextView
                android:id="@+id/stripText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:text="@string/style_preview_sample"
                android:textSize="@dimen/text_body" />

            <View
                android:id="@+id/stripAccent"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="end|center_vertical" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/slotGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:checkedButton="@id/slotSurface"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/slotSurface"
                style="@style/Widget.Supernova.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_slot_surface" />

            <Button
                android:id="@+id/slotText"
                style="@style/Widget.Supernova.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_slot_text" />

            <Button
                android:id="@+id/slotAccent"
                style="@style/Widget.Supernova.Button.Segment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_slot_accent" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Minimum contrast, shown on the Text slot. -->
        <LinearLayout
            android:id="@+id/contrastRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_ms"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/contrastSeek"
                    android:text="@string/style_min_contrast"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/contrastValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/style_min_contrast_summary"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_secondary" />

            <SeekBar
                android:id="@+id/contrastSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:max="12" />
        </LinearLayout>

        <TextView
            android:id="@+id/styleGlassNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:text="@string/style_bar_glass_note"
            android:textColor="@color/textSecondary"
            android:textSize="@dimen/text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/swatchRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Any color: hue, saturation, brightness and hex, for one-color pickers. -->
        <LinearLayout
            android:id="@+id/customRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

        <Button
            android:id="@+id/styleDefault"
            style="@style/Widget.Supernova.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/option_default" />

        <LinearLayout
            android:id="@+id/opacityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/opacitySeek"
                    android:text="@string/style_opacity"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/opacityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/opacitySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:max="100" />
        </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
