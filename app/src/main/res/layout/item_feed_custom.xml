<?xml version="1.0" encoding="utf-8"?>
<!-- One custom card: its name with a caption ("Pinned") when it has one, the featured tile or hosted widget, then icon+label action
     pills that wrap. An unnamed card has no header. Its menu is a
     long-press away. Bound everywhere it appears (feed, drawer, search,
     editor preview) by ui/CardViewBinder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_feed_card"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <LinearLayout
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_ms"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/customName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/cardCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Featured content: an app/shortcut launch tile or a hosted widget
         view, added programmatically. -->
    <FrameLayout
        android:id="@+id/customFeatured"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Action pills (<= 6), added programmatically. -->
    <com.supernova.launcher.ui.FlowLayout
        android:id="@+id/customActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms" />
</LinearLayout>
