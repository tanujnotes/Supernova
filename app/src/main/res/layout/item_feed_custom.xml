<?xml version="1.0" encoding="utf-8"?>
<!-- One custom card: a header row (type mark, name, menu), the
     featured tile or hosted widget, a hairline, then icon+label action pills
     that wrap. Bound everywhere it appears (feed, drawer, search, editor
     preview) by ui/CardViewBinder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_sm"
    android:background="@drawable/bg_feed_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_ms"
    android:paddingBottom="@dimen/space_ms">

    <LinearLayout
        android:id="@+id/cardHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/cardTypeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="@dimen/space_ms"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_card_star" />

        <com.supernova.launcher.ui.FadingTextView
            android:id="@+id/customName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textSize="@dimen/text_body" />

        <!-- Activation history: a tap says when the card last
             activated. -->
        <ImageButton
            android:id="@+id/cardHistory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/card_history"
            android:src="@drawable/ic_history"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/cardMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/card_menu"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Featured content: an app/shortcut launch tile or a hosted widget
         view, added programmatically. -->
    <FrameLayout
        android:id="@+id/customFeatured"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm" />

    <View
        android:id="@+id/cardDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_ms"
        android:importantForAccessibility="no" />

    <!-- Action pills (<= 6), added programmatically. -->
    <com.supernova.launcher.ui.FlowLayout
        android:id="@+id/customActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms" />
</LinearLayout>
