<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="10dp">

    <TextView
        android:id="@+id/settingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/textPrimary"
        android:textSize="15sp" />

    <!-- Mini strip mirroring the style picker's live preview: the resolved
         surface behind sample text and the accent as a dot. -->
    <FrameLayout
        android:id="@+id/styleStrip"
        android:layout_width="104dp"
        android:layout_height="40dp"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/styleStripText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:text="@string/style_strip_sample"
            android:textSize="14sp" />

        <View
            android:id="@+id/styleStripAccent"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="12dp" />
    </FrameLayout>
</LinearLayout>
