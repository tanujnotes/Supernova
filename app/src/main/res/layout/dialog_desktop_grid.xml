<?xml version="1.0" encoding="utf-8"?>
<!-- The grid dialog: the grid drawn to scale in a phone-shaped box, then
     a row per count with its minus and plus on the steppers' light circles,
     and the subgrid option (the desktop's only). The rows reach the
     dialog's sides; their text keeps its 24dp inset. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="230dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_settings_grid_inset"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

        <com.supernova.launcher.ui.settings.preview.MiniGridView
            android:id="@+id/gridPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/grid_cols"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/colsDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_step_circle"
            android:contentDescription="@string/stepper_decrease"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_step_minus" />

        <TextView
            android:id="@+id/colsValue"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/colsUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_step_circle"
            android:contentDescription="@string/stepper_increase"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_step_plus" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="24dp"
        android:background="@color/settingsDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/grid_rows"
            android:textColor="@color/textPrimary"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/rowsDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_step_circle"
            android:contentDescription="@string/stepper_decrease"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_step_minus" />

        <TextView
            android:id="@+id/rowsValue"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/textPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/rowsUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_step_circle"
            android:contentDescription="@string/stepper_increase"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_step_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/subgridRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:background="@color/settingsDivider" />

        <LinearLayout
            android:id="@+id/subgridToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="8dp">
    
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/subgrid"
                android:textColor="@color/textPrimary"
                android:textSize="16sp" />
    
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/subgridCheck"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="48dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
