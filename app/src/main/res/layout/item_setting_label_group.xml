<?xml version="1.0" encoding="utf-8"?>
<!-- The Label group, a row in its card. Its checkbox shows or hides the
     labels; the rest of the row opens the group, whose own options (size,
     font, shadow, single line) sit on a faint band across the card, in the
     same rows and control column as everything around them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/space_xs">

        <LinearLayout
            android:id="@+id/labelHeader"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_sm"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_sm">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/labelSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <ImageView
                android:id="@+id/labelChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/space_sm"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/textSecondary" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="@color/settingsDivider" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/labelSwitch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/show_labels"
            android:minWidth="48dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/labelBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/settingsBand"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_xs"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_sm"
            android:paddingVertical="@dimen/space_ms">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/label_card_size"
                    android:textColor="@color/textPrimary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/labelSizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="44dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="@dimen/text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/labelSizeDown"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_step_circle"
                    android:contentDescription="@string/stepper_decrease"
                    android:padding="@dimen/space_ms"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_step_minus" />

                <SeekBar
                    android:id="@+id/labelSizeSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:contentDescription="@string/label_size"
                    android:paddingHorizontal="@dimen/space_sm" />

                <ImageButton
                    android:id="@+id/labelSizeUp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_step_circle"
                    android:contentDescription="@string/stepper_increase"
                    android:padding="@dimen/space_ms"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_step_plus" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/space_md"
            android:background="@color/settingsDivider" />

        <LinearLayout
            android:id="@+id/labelFontBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/label_font"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_card_font"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/labelFontValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:ellipsize="end"
                android:maxWidth="160dp"
                android:maxLines="1"
                android:textColor="@color/textSecondary"
                android:textSize="@dimen/text_secondary" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="20dp"
                android:layout_marginStart="@dimen/space_sm"
                android:importantForAccessibility="no"
                android:paddingHorizontal="@dimen/space_md"
                android:src="@drawable/ic_settings_chevron"
                app:tint="@color/textSecondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/space_md"
            android:background="@color/settingsDivider" />

        <LinearLayout
            android:id="@+id/labelShadowCell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_card_shadow"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/labelShadowCheck"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_md"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="48dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="@dimen/space_md"
            android:background="@color/settingsDivider" />

        <LinearLayout
            android:id="@+id/labelSingleLineCell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/label_card_single_line"
                android:textColor="@color/textPrimary"
                android:textSize="@dimen/text_body" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/labelSingleLineCheck"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_md"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="48dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
