<?xml version="1.0" encoding="utf-8"?>
<!-- The app's type and spacing scale. Layouts and styles take their text
     sizes and their paddings and margins from here rather than inline
     numbers, so sibling screens agree. -->
<resources>
    <!-- Text: six steps. -->
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_secondary">14sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_title">20sp</dimen>
    <dimen name="text_headline">24sp</dimen>
    <dimen name="text_display">32sp</dimen>

    <!-- Spacing: a 4dp grid. -->
    <dimen name="space_xxs">2dp</dimen>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_ms">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_ml">20dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- The smallest comfortable touch target. -->
    <dimen name="touch_min">48dp</dimen>
</resources>
