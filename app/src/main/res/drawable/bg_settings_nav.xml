<?xml version="1.0" encoding="utf-8"?>
<!-- The settings tab bar's plate: its own shade with a hairline along the
     top, where the cards scroll under it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/settingsNav" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/settingsDivider" />
        </shape>
    </item>
</layer-list>
