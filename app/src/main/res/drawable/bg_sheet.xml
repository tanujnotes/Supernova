<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom-sheet plate, for a sheet that paints its own surface over the
     theme's (the widget picker wears the drawer color): the same top corners
     as Widget.Supernova.BottomSheet, so nothing of the theme's plate shows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
    <solid android:color="@color/surface" />
</shape>
